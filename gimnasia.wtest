import gimnasia.*

describe "rutinas" {

    //Punto 1: rutinas
//	const correrEnLaPlaya = // Una actividad de running con intensisdad 1.2
//	const remarEnElDelta = // Una actividad de remo
//	const remarEnCaminoRemeros = // Una actividad de remo comptetitivo
//	const maratonBA = //Una maraton con intensidad 1.5
//Punto 2: personas
	//const  = //Una persona Sedentaria con peso 60 y tiempo de ejerciciso 5
 	//const bob =  // Una persona atleta con peso 40 

		const correrEnLaPlaya = new Running(intensidad = 1.2)
		const maratonBA = new Maratón()
		const remarEnELDelta = new Remo() 
		const remarEnCaminosRemeros = new RemoDeCompetición()

		const calamardo = new Sedentaria(peso = 60, tiempo = 5)
		const bob = new Atleta(peso=40)

	test "Correr en la playa" {
	    correrEnLaPlaya.tiempo(5)
		assert.equals(360,calamardo.pesoPerdido(correrEnLaPlaya))

		correrEnLaPlaya.tiempo(90)
		assert.equals(10200,calamardo.pesoPerdido(correrEnLaPlaya))
	}
	test "maraton BA" {
		maratonBA.intensidad(1.5)
		maratonBA.tiempo(5)

        assert.equals(900,maratonBA.caloriasConsumidas())

		maratonBA.tiempo(90)

		assert.equals(25500,maratonBA.caloriasConsumidas())
	}
	test "remar en el delta"{
		
		remarEnELDelta.tiempo(5)
		
		assert.equals(520,remarEnELDelta.caloriasConsumidas())
        remarEnELDelta.tiempo(90)
		assert.equals(9360,remarEnELDelta.caloriasConsumidas())
	}
    test "remar en caminos remeros" {
        remarEnCaminosRemeros.tiempo(5)

		assert.equals(510,remarEnCaminosRemeros.caloriasConsumidas())

        remarEnCaminosRemeros.tiempo(90)

		assert.equals(12750,remarEnCaminosRemeros.caloriasConsumidas())
	}
	test "Calamardo corre en la playa" {
        calamardo.tiempo(5)
        calamardo.aplicarRutina(correrEnLaPlaya)
        assert.equals( 59948 , calamardo.peso() )
}
	test "Calamardo corre en la maraton" {
		calamardo.aplicarRutina(maratonBA)
        assert.equals(59.871, calamardo.peso())

	}
	test "Calamardo rema en el Delta" {

		calamardo.aplicarRutina(remarEnELDelta)
        assert.equals(59.871, calamardo.peso())
	}
	test "Camardo rema en caminos remeros" {

		calamardo.aplicarRutina(remarEnCaminosRemeros)
        assert.equals(59.871, calamardo.peso())
	}



